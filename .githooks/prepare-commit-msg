#!/bin/sh
# Strip Cursor/agent co-author trailers so they never land in commits or pushes.
MSG_FILE="$1"
SOURCE="${2:-}"
if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi
# Portable: remove Co-authored-by lines that mention Cursor / cursoragent
tmp="${MSG_FILE}.tmp"
grep -viE '^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]ursor' "$MSG_FILE" | \
  grep -viE '^[[:space:]]*Co-authored-by:[[:space:]].*cursoragent@' > "$tmp" || true
# If grep removed everything somehow, keep original
if [ -s "$tmp" ] || [ ! -s "$MSG_FILE" ]; then
  mv "$tmp" "$MSG_FILE"
else
  rm -f "$tmp"
fi
exit 0