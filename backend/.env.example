# Dedicated Recruitment Portal Supabase project in the Nippon Toyota org.
# Do NOT reuse the payslip portal project's DATABASE_URL.
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooler URI if direct db.*.supabase.co is blocked on your network.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DB_SCHEMA=recruitment
SECRET_KEY=change-me-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage (Project Settings → API). Service role key stays on the server only.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=candidate-documents

# Comma-separated SPA origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
